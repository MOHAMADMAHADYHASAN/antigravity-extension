{
  "name": "upgradelens",
  "displayName": "UpgradeLens - Framework Migration Assistant",
  "description": "Scans your codebase on framework upgrades (Next.js, React, Prisma, etc.) and generates actionable migration reports.",
  "version": "0.1.12",
  "publisher": "antigravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/MOHAMADMAHADYHASAN/antigravity-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:package.json",
    "onCommand:upgradelens.scanProject",
    "onCommand:upgradelens.customScan",
    "onCommand:upgradelens.inspectDependencies",
    "onCommand:upgradelens.saveReport",
    "onCommand:antigravity.scanProject",
    "onCommand:antigravity.customScan",
    "onCommand:antigravity.inspectDependencies",
    "onCommand:antigravity.saveReport"
  ],
  "contributes": {
    "commands": [
      {
        "command": "upgradelens.scanProject",
        "title": "Run Migration Scan",
        "category": "UpgradeLens"
      },
      {
        "command": "upgradelens.customScan",
        "title": "Run Custom Version Scan",
        "category": "UpgradeLens"
      },
      {
        "command": "upgradelens.inspectDependencies",
        "title": "Inspect Tracked Dependencies",
        "category": "UpgradeLens"
      },
      {
        "command": "upgradelens.saveReport",
        "title": "Save Migration Report to File",
        "category": "UpgradeLens"
      },
      {
        "command": "antigravity.scanProject",
        "title": "Run Migration Scan (Legacy Alias)",
        "category": "UpgradeLens"
      },
      {
        "command": "antigravity.customScan",
        "title": "Run Custom Version Scan (Legacy Alias)",
        "category": "UpgradeLens"
      },
      {
        "command": "antigravity.inspectDependencies",
        "title": "Inspect Tracked Dependencies (Legacy Alias)",
        "category": "UpgradeLens"
      },
      {
        "command": "antigravity.saveReport",
        "title": "Save Migration Report to File (Legacy Alias)",
        "category": "UpgradeLens"
      }
    ],
    "configuration": {
      "title": "UpgradeLens",
      "properties": {
        "upgradelens.autoScanOnDependencyChange": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "How UpgradeLens should respond when dependency version upgrades are detected."
        },
        "upgradelens.saveReportToFile": {
          "type": "boolean",
          "default": false,
          "description": "Whether to automatically save migration reports as physical files in the workspace."
        },
        "upgradelens.reportOutputPath": {
          "type": "string",
          "default": "MIGRATION_REPORT.md",
          "description": "File path where migration reports will be saved when enabled."
        },
        "upgradelens.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/.next/**",
            "**/generated/**",
            "**/.prisma/**",
            "**/@prisma/client/**",
            "**/prisma/runtime/**",
            "**/prisma/client/**",
            "**/prisma/migrations/**",
            "**/*.min.js"
          ],
          "description": "Glob patterns to exclude from codebase scans."
        },
        "upgradelens.remoteManifestUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/MOHAMADMAHADYHASAN/antigravity-extension/main/remote-rules/manifest.json",
          "description": "URL of the central manifest.json for version-based remote rules loading."
        },
        "antigravity.autoScanOnDependencyChange": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "(Legacy) How UpgradeLens should respond when dependency version upgrades are detected."
        },
        "antigravity.saveReportToFile": {
          "type": "boolean",
          "default": false,
          "description": "(Legacy) Whether to automatically save migration reports as physical files in the workspace."
        },
        "antigravity.reportOutputPath": {
          "type": "string",
          "default": "MIGRATION_REPORT.md",
          "description": "(Legacy) File path where migration reports will be saved when enabled."
        },
        "antigravity.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**",
            "**/.next/**",
            "**/generated/**",
            "**/.prisma/**",
            "**/@prisma/client/**",
            "**/prisma/runtime/**",
            "**/prisma/client/**",
            "**/prisma/migrations/**",
            "**/*.min.js"
          ],
          "description": "(Legacy) Glob patterns to exclude from codebase scans."
        },
        "antigravity.remoteManifestUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/MOHAMADMAHADYHASAN/antigravity-extension/main/remote-rules/manifest.json",
          "description": "(Legacy) URL of the central manifest.json for version-based remote rules loading."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "build": "tsc -p ./ --noEmit && node esbuild.js --production",
    "test": "tsx --test test/**/*.test.ts",
    "release": "rm -f *.vsix && npm version patch && npx @vscode/vsce package --baseContentUrl https://github.com/MOHAMADMAHADYHASAN/antigravity-extension --baseImagesUrl https://github.com/MOHAMADMAHADYHASAN/antigravity-extension"
  },
  "dependencies": {
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.2",
    "@babel/traverse": "^7.25.9",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.17.0",
    "@types/semver": "^7.5.8",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
