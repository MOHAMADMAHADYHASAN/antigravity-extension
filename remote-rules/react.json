    }
  },
  {
    "id": "react-19-use-action-state",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "useFormState replaced by useActionState in React 19",
    "docsUrl": "https://react.dev/reference/react/useActionState",
    "description": "In React 19, useFormState from 'react-dom' is deprecated in favor of useActionState from 'react'.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["useFormState"],
      "astPattern": {
        "type": "import",
        "source": "react-dom",
        "specifiers": ["useFormState"]
      }
    },
    "remediation": {
      "summary": "Replace useFormState from 'react-dom' with useActionState imported from 'react'.",
      "exampleBefore": "import { useFormState } from 'react-dom';",
      "exampleAfter": "import { useActionState } from 'react';"
    }
  },
  {
    "id": "react-19-deprecated-forward-ref",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "forwardRef is deprecated; ref is a standard prop on function components in React 19",
    "docsUrl": "https://react.dev/reference/react/forwardRef",
    "description": "In React 19, function components can accept ref directly as a prop. forwardRef wrapper is deprecated and will be removed in future versions.",
    "detection": {
      "fileExtensions": [".jsx", ".tsx"],
      "fastFilter": ["forwardRef"],
      "astPattern": {
        "type": "callExpression",
        "callee": "forwardRef"
      }
    },
    "remediation": {
      "summary": "Remove forwardRef wrapper and receive ref directly as a prop in component arguments.",
      "exampleBefore": "const Input = forwardRef((props, ref) => <input ref={ref} />);",
      "exampleAfter": "function Input({ ref, ...props }) { return <input ref={ref} />; }"
    }
  },
  {
    "id": "react-19-deprecated-context-provider",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "<Context.Provider> is deprecated in favor of rendering <Context> directly in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#context-as-a-provider",
    "description": "In React 19, you can render <Context value={...}> directly instead of <Context.Provider value={...}>.",
    "detection": {
      "fileExtensions": [".jsx", ".tsx"],
      "fastFilter": [".Provider", "Provider"],
      "astPattern": {
        "type": "jsxElement",
        "property": "Provider"
      }
    },
    "remediation": {
      "summary": "Render the Context object directly instead of using .Provider.",
      "exampleBefore": "<ThemeContext.Provider value={theme}>{children}</ThemeContext.Provider>",
      "exampleAfter": "<ThemeContext value={theme}>{children}</ThemeContext>"
    }
  },
  {
    "id": "react-19-useref-no-arguments",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "useRef() requires an initial value argument in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#typescript-changes",
    "description": "In React 19 TypeScript typings, calling useRef() without arguments is deprecated and requires passing an initial value like useRef(null).",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["useRef()", "useRef<"],
      "astPattern": {
        "type": "callExpression",
        "callee": "useRef",
        "argCount": 0
      }
    },
    "remediation": {
      "summary": "Pass an explicit initial value such as null to useRef().",
      "exampleBefore": "const ref = useRef();",
      "exampleAfter": "const ref = useRef(null);"
    }
  },
  {
    "id": "react-19-deprecated-react-test-renderer",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "react-test-renderer package is deprecated in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#deprecated-react-test-renderer",
    "description": "react-test-renderer is deprecated in React 19. Migrate your test suites to React Testing Library (@testing-library/react).",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["react-test-renderer"],
      "astPattern": {
        "type": "import",
        "source": "react-test-renderer"
      }
    },
    "remediation": {
      "summary": "Migrate tests using react-test-renderer to @testing-library/react.",
      "exampleBefore": "import TestRenderer from 'react-test-renderer';",
      "exampleAfter": "import { render } from '@testing-library/react';"
    }
  }
]
