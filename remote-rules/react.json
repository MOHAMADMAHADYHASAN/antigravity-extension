    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "react-dom/test-utils package has been deprecated and act moved to 'react'",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-reactdom-apis",
    "description": "react-dom/test-utils has been deprecated in React 19 and act has moved to the core 'react' package.",
