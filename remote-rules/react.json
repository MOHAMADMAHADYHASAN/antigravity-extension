[
  {
    "id": "react-19-removed-reactdom-render",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "ReactDOM.render has been removed in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-reactdom-apis",
    "description": "ReactDOM.render was deprecated in React 18 and is completely removed in React 19. Using it will result in a runtime error.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["ReactDOM.render", "render("],
      "astPattern": {
        "type": "callExpression",
        "callee": "ReactDOM.render"
      }
    },
    "remediation": {
      "summary": "Use createRoot from 'react-dom/client' instead.",
      "exampleBefore": "import ReactDOM from 'react-dom';\nReactDOM.render(<App />, document.getElementById('root'));",
      "exampleAfter": "import { createRoot } from 'react-dom/client';\nconst root = createRoot(document.getElementById('root')!);\nroot.render(<App />);"
    }
  },
  {
    "id": "react-19-removed-reactdom-hydrate",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "ReactDOM.hydrate has been removed in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-reactdom-apis",
    "description": "ReactDOM.hydrate has been removed in React 19. Applications must migrate to hydrateRoot from 'react-dom/client'.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["ReactDOM.hydrate", "hydrate("],
      "astPattern": {
        "type": "callExpression",
        "callee": "ReactDOM.hydrate"
      }
    },
    "remediation": {
      "summary": "Replace ReactDOM.hydrate with hydrateRoot from 'react-dom/client'.",
      "exampleBefore": "import ReactDOM from 'react-dom';\nReactDOM.hydrate(<App />, container);",
      "exampleAfter": "import { hydrateRoot } from 'react-dom/client';\nhydrateRoot(container, <App />);"
    }
  },
  {
    "id": "react-19-removed-unmount-component",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "ReactDOM.unmountComponentAtNode has been removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-reactdom-apis",
    "description": "unmountComponentAtNode has been removed in favor of root.unmount().",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["unmountComponentAtNode"],
      "astPattern": {
        "type": "callExpression",
        "callee": "ReactDOM.unmountComponentAtNode"
      }
    },
    "remediation": {
      "summary": "Use root.unmount() on the createRoot instance.",
      "exampleBefore": "ReactDOM.unmountComponentAtNode(container);",
      "exampleAfter": "root.unmount();"
    }
  },
  {
    "id": "react-19-removed-find-dom-node",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "findDOMNode has been removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-reactdom-apis",
    "description": "findDOMNode was an escape hatch that breaks React's tree abstraction and has been removed.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["findDOMNode"],
      "astPattern": {
        "type": "callExpression",
        "callee": "ReactDOM.findDOMNode"
      }
    },
    "remediation": {
      "summary": "Pass a ref directly to the DOM element.",
      "exampleBefore": "const node = ReactDOM.findDOMNode(this);",
      "exampleAfter": "const node = this.myRef.current;"
    }
  },
  {
    "id": "react-19-removed-proptypes",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "React.PropTypes is removed from core package",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "PropTypes has been removed from React. Use TypeScript or the separate 'prop-types' package.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["React.PropTypes"],
      "astPattern": {
        "type": "memberExpression",
        "object": "React",
        "property": "PropTypes"
      }
    },
    "remediation": {
      "summary": "Import from 'prop-types' package or migrate to TypeScript interfaces.",
      "exampleBefore": "MyComponent.propTypes = React.PropTypes.string;",
      "exampleAfter": "import PropTypes from 'prop-types';\nMyComponent.propTypes = PropTypes.string;"
    }
  },
  {
    "id": "react-19-removed-string-refs",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "Legacy string refs are removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "Using string literals for ref props (e.g. ref=\"myInput\") is completely removed in React 19.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["ref="],
      "astPattern": {
        "type": "jsxAttribute",
        "attribute": "ref",
        "disallowLiteralString": true
      }
    },
    "remediation": {
      "summary": "Use useRef or callback refs instead of string identifiers.",
      "exampleBefore": "<input ref=\"usernameInput\" />",
      "exampleAfter": "const inputRef = useRef<HTMLInputElement>(null);\n<input ref={inputRef} />"
    }
  },
  {
    "id": "react-19-removed-this-refs",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "this.refs property access on class components has been removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "Accessing this.refs on class components has been completely removed in React 19. Migrate to React.createRef().",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["this.refs"],
      "astPattern": {
        "type": "memberExpression",
        "object": "this",
        "property": "refs"
      }
    },
    "remediation": {
      "summary": "Replace this.refs with React.createRef() in class components or convert to function components with useRef().",
      "exampleBefore": "this.refs.input.focus();",
      "exampleAfter": "this.inputRef.current?.focus();"
    }
  },
  {
    "id": "react-19-removed-default-props-function",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "defaultProps on function components has been removed in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "Defining defaultProps on function components is no longer supported in React 19. Use standard JavaScript default parameters in component arguments.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["defaultProps"],
      "astPattern": {
        "type": "memberExpression",
        "property": "defaultProps"
      }
    },
    "remediation": {
      "summary": "Migrate defaultProps on function components to ES6 default parameter syntax.",
      "exampleBefore": "MyComponent.defaultProps = { theme: 'light' };",
      "exampleAfter": "function MyComponent({ theme = 'light' }) {}"
    }
  },
  {
    "id": "react-19-removed-legacy-lifecycles",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "deprecation",
    "title": "Legacy lifecycle methods are removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "componentWillMount, componentWillReceiveProps, and componentWillUpdate without UNSAFE_ prefix have been removed.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": [
        "componentWillMount",
        "componentWillReceiveProps",
        "componentWillUpdate"
      ],
      "astPattern": {
        "type": "identifier",
        "name": "componentWillReceiveProps",
        "context": "method"
      }
    },
    "remediation": {
      "summary": "Migrate to componentDidMount, componentDidUpdate, or React function components with useEffect.",
      "exampleBefore": "componentWillReceiveProps(nextProps) { ... }",
      "exampleAfter": "componentDidUpdate(prevProps) { ... }"
    }
  },
  {
    "id": "react-19-removed-legacy-context",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "Legacy Context API (contextTypes, childContextTypes) has been removed",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "The legacy Context API using contextTypes and childContextTypes has been completely removed in React 19. Use React.createContext() and the use() hook.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["contextTypes", "childContextTypes"],
      "astPattern": {
        "type": "identifier",
        "name": "contextTypes",
        "context": "property"
      }
    },
    "remediation": {
      "summary": "Migrate legacy contextTypes to React.createContext() and the use(Context) hook.",
      "exampleBefore": "Component.contextTypes = { store: PropTypes.object };",
      "exampleAfter": "const store = use(StoreContext);"
    }
  },
  {
    "id": "react-19-removed-create-factory",
    "framework": "react",
    "fromVersion": ">=18.0.0 <19.0.0",
    "toVersion": ">=19.0.0",
    "severity": "breaking",
    "title": "React.createFactory has been removed in React 19",
    "docsUrl": "https://react.dev/blog/2024/04/25/react-19-upgrade-guide#removed-deprecated-react-apis",
    "description": "React.createFactory was deprecated in older versions and is completely removed in React 19. Use standard JSX elements.",
    "detection": {
      "fileExtensions": [".js", ".jsx", ".ts", ".tsx"],
      "fastFilter": ["createFactory"],
      "astPattern": {
        "type": "callExpression",
        "callee": "createFactory"
      }
    },
    "remediation": {
      "summary": "Replace React.createFactory invocations with direct JSX elements.",
      "exampleBefore": "const button = React.createFactory('button');\nreturn button({ onClick }, 'Click');",
      "exampleAfter": "return <button onClick={onClick}>Click</button>;"
    }
  },
  {
