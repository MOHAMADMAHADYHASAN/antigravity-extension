      "fastFilter": ["react-dom/test-utils"],
      "astPattern": {
        "type": "import",
        "source": "react-dom/test-utils"
      }
    },
    "remediation": {
      "summary": "Import act from 'react' instead of 'react-dom/test-utils'.",
